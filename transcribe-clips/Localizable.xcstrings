{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%lld clips done, %lld failed.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld کلیپ انجام شد، %lld ناموفق."
          }
        }
      }
    },
    "%lld clips now have subtitles.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld کلیپ اکنون زیرنویس دارند."
          }
        }
      }
    },
    "%lld done": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld انجام شده"
          }
        }
      }
    },
    "%lld failed": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ناموفق"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld انتخاب شده"
          }
        }
      }
    },
    "%lld.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld."
          }
        }
      }
    },
    "1. One-time setup": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۱. تنظیم اولیه (فقط یک بار)"
          }
        }
      }
    },
    "2. Make subtitles": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۲. ساخت زیرنویس"
          }
        }
      }
    },
    "3. Import into DaVinci Resolve": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۳. وارد کردن در DaVinci Resolve"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید API"
          }
        }
      }
    },
    "API key, language and subtitle options": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید API، زبان و تنظیمات زیرنویس"
          }
        }
      }
    },
    "Add your API key in Settings first.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا کلید API را در تنظیمات وارد کنید."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشرفته"
          }
        }
      }
    },
    "App language": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان برنامه"
          }
        }
      }
    },
    "Arabic": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی"
          }
        }
      }
    },
    "Busy — retrying in %lld s": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس شلوغ است — تلاش دوباره تا %lld ثانیه"
          }
        }
      }
    },
    "Can't read this file. Export it from DaVinci Resolve as a MOV or MP4 first.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل خوانده نمی‌شود. ابتدا آن را از DaVinci Resolve به‌صورت MOV یا MP4 خروجی بگیرید."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو شد"
          }
        }
      }
    },
    "Characters per line": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد نویسه در هر خط"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب"
          }
        }
      }
    },
    "Choose a folder of video clips": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب پوشهٔ کلیپ‌های ویدیویی"
          }
        }
      }
    },
    "Choose the folder that contains your video clips": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشه‌ای را که کلیپ‌های ویدیویی در آن است انتخاب کنید"
          }
        }
      }
    },
    "Clip": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیپ"
          }
        }
      }
    },
    "Clip Transcriber": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرنویس‌ساز کلیپ"
          }
        }
      }
    },
    "Clip Transcriber User Guide": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راهنمای زیرنویس‌ساز کلیپ"
          }
        }
      }
    },
    "Clip Transcriber creates an .srt subtitle file next to each video clip so it can be imported into DaVinci Resolve.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرنویس‌ساز کلیپ برای هر کلیپ ویدیویی یک فایل زیرنویس ‎.srt کنار همان کلیپ می‌سازد تا بتوانید آن را در DaVinci Resolve وارد کنید."
          }
        }
      }
    },
    "Clip Transcriber needs to restart to change its language.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر زبان، زیرنویس‌ساز کلیپ باید دوباره باز شود."
          }
        }
      }
    },
    "Clips transcribed at once": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کلیپ‌های هم‌زمان"
          }
        }
      }
    },
    "Colours use SRT font tags. Most players show them; DaVinci Resolve may ignore them, so try one clip first.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رنگ‌ها با تگ‌های font در SRT اعمال می‌شوند. بیشتر پخش‌کننده‌ها آن‌ها را نشان می‌دهند؛ DaVinci Resolve ممکن است نادیده‌شان بگیرد، پس اول با یک کلیپ امتحان کنید."
          }
        }
      }
    },
    "Could not extract the audio: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استخراج صدا ممکن نشد: %@"
          }
        }
      }
    },
    "Could not read the key: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید خوانده نشد: %@"
          }
        }
      }
    },
    "Could not read the saved API key: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید API ذخیره‌شده خوانده نشد: %@"
          }
        }
      }
    },
    "Could not save the key: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید ذخیره نشد: %@"
          }
        }
      }
    },
    "Detect automatically": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تشخیص خودکار"
          }
        }
      }
    },
    "Detect different speakers": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تشخیص گویندگان مختلف"
          }
        }
      }
    },
    "Done · %lld subtitles": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انجام شد · %lld زیرنویس"
          }
        }
      }
    },
    "Drop a folder of video clips here": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشهٔ کلیپ‌های ویدیویی را اینجا رها کنید"
          }
        }
      }
    },
    "Drop the folder that contains the clips onto the window, or press ⌘O and choose it. Subfolders are included.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشه‌ای را که کلیپ‌ها در آن هستند روی پنجره رها کنید، یا ⌘O را بزنید و آن را انتخاب کنید. زیرپوشه‌ها هم جست‌وجو می‌شوند."
          }
        }
      }
    },
    "Duration": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت"
          }
        }
      }
    },
    "English": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انگلیسی"
          }
        }
      }
    },
    "Extracting audio": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استخراج صدا"
          }
        }
      }
    },
    "Follow system language": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابق زبان سیستم"
          }
        }
      }
    },
    "French": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرانسوی"
          }
        }
      }
    },
    "German": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آلمانی"
          }
        }
      }
    },
    "Get an ElevenLabs API key…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دریافت کلید API از ElevenLabs…"
          }
        }
      }
    },
    "Give each speaker a different colour": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر گوینده با رنگ متفاوت"
          }
        }
      }
    },
    "How to use Clip Transcriber": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راهنمای استفاده از زیرنویس‌ساز کلیپ"
          }
        }
      }
    },
    "How to use the app, step by step": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راهنمای گام‌به‌گام استفاده از برنامه"
          }
        }
      }
    },
    "If the app is closed mid-way, open the same folder again and tick the remaining clips.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر برنامه وسط کار بسته شد، دوباره همان پوشه را باز کنید و کلیپ‌های باقی‌مانده را تیک بزنید."
          }
        }
      }
    },
    "Keep a copy of the full transcript (.transcript.json)": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگه‌داشتن نسخهٔ کامل متن (.transcript.json)"
          }
        }
      }
    },
    "Keep the laptop lid open while it works; the app can run in the background.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در طول کار، درِ لپ‌تاپ را نبندید؛ برنامه می‌تواند در پس‌زمینه کار کند."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان"
          }
        }
      }
    },
    "Longest subtitle": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین مدت هر زیرنویس"
          }
        }
      }
    },
    "Names and special words": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام‌ها و واژه‌های خاص"
          }
        }
      }
    },
    "Network problem: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشکل شبکه: %@"
          }
        }
      }
    },
    "No video or audio clips found": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کلیپ ویدیویی یا صوتی پیدا نشد"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باشه"
          }
        }
      }
    },
    "One per line. Character names, places and unusual words help the transcription get spelling right.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کدام در یک خط. نام شخصیت‌ها، مکان‌ها و واژه‌های نامعمول به درست‌نویسی متن کمک می‌کنند."
          }
        }
      }
    },
    "Open Folder…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن پوشه…"
          }
        }
      }
    },
    "Open Settings (⌘,) and paste the API key you were given into “API key”, then press “Test Key” — you should see a green check.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات را باز کنید (⌘,) و کلیدی را که برایتان فرستاده شده در «کلید API» بچسبانید، سپس «آزمایش کلید» را بزنید — باید تیک سبز ببینید."
          }
        }
      }
    },
    "Optional: under “Names and special words”, list the characters and places in the film, one per line. It helps the transcription spell them correctly.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: در «نام‌ها و واژه‌های خاص» نام شخصیت‌ها و مکان‌های فیلم را هر کدام در یک خط بنویسید تا املای آن‌ها درست دربیاید."
          }
        }
      }
    },
    "Persian": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فارسی"
          }
        }
      }
    },
    "Please drop a folder, not individual files. Subtitles are saved next to the clips inside the folder.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لطفاً یک پوشه رها کنید، نه فایل‌های جداگانه. زیرنویس‌ها کنار کلیپ‌ها داخل همان پوشه ذخیره می‌شوند."
          }
        }
      }
    },
    "Press Start. Each clip goes: Extracting audio → Uploading → Transcribing → Done.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«شروع» را بزنید. هر کلیپ این مراحل را طی می‌کند: استخراج صدا ← بارگذاری ← تبدیل گفتار به متن ← انجام شد."
          }
        }
      }
    },
    "Re-scan the folder for new clips or deleted subtitles": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجوی دوبارهٔ پوشه برای کلیپ‌های جدید یا زیرنویس‌های حذف‌شده"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تازه‌سازی"
          }
        }
      }
    },
    "Restart": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن دوباره"
          }
        }
      }
    },
    "Restart to switch language?": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر زبان، برنامه دوباره باز شود؟"
          }
        }
      }
    },
    "Retry Failed": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش دوباره برای ناموفق‌ها"
          }
        }
      }
    },
    "Right-click in the Media Pool → Import → Subtitle…, choose the .srt and drag it onto the timeline.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Media Pool راست‌کلیک کنید ← Import ← Subtitle…، فایل ‎.srt را انتخاب کنید و آن را روی تایم‌لاین بکشید."
          }
        }
      }
    },
    "Same name as another clip": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هم‌نام با کلیپ دیگری"
          }
        }
      }
    },
    "Saving subtitles": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیرهٔ زیرنویس"
          }
        }
      }
    },
    "Scanning…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال جست‌وجو…"
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب همه"
          }
        }
      }
    },
    "Select None": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو انتخاب همه"
          }
        }
      }
    },
    "Service": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس"
          }
        }
      }
    },
    "Set “Spoken language” to Persian.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«زبان گفتار» را روی فارسی بگذارید."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش در Finder"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشکلی پیش آمد"
          }
        }
      }
    },
    "Spanish": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپانیایی"
          }
        }
      }
    },
    "Spoken language": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان گفتار"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت"
          }
        }
      }
    },
    "Stop transcribing": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف"
          }
        }
      }
    },
    "Subtitles": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرنویس"
          }
        }
      }
    },
    "Subtitles (.srt) are saved next to each clip.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرنویس‌ها (.srt) کنار هر کلیپ ذخیره می‌شوند."
          }
        }
      }
    },
    "Subtitles exist": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرنویس موجود است"
          }
        }
      }
    },
    "Switch the app between English and Persian": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر زبان برنامه بین انگلیسی و فارسی"
          }
        }
      }
    },
    "Test Key": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آزمایش کلید"
          }
        }
      }
    },
    "The API key was rejected. Check it in Settings.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید API پذیرفته نشد. آن را در تنظیمات بررسی کنید."
          }
        }
      }
    },
    "The key is saved when you press Test Key or close this window.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید هنگام زدن «آزمایش کلید» یا بستن این پنجره ذخیره می‌شود."
          }
        }
      }
    },
    "The service could not process this clip: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس نتوانست این کلیپ را پردازش کند: %@"
          }
        }
      }
    },
    "The service had a problem (error %lld). Try again later.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس با مشکل مواجه شد (خطای %lld). بعداً دوباره تلاش کنید."
          }
        }
      }
    },
    "The service is busy. Try again in a few minutes.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس شلوغ است. چند دقیقهٔ دیگر دوباره تلاش کنید."
          }
        }
      }
    },
    "The service refused the API key: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس کلید API را نپذیرفت: %@"
          }
        }
      }
    },
    "The service refused this request: %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس این درخواست را رد کرد: %@"
          }
        }
      }
    },
    "The service sent an unexpected reply.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس پاسخ غیرمنتظره‌ای فرستاد."
          }
        }
      }
    },
    "This API key isn't allowed to do that. In ElevenLabs, edit the key's permissions and enable “Speech to Text”.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلید API اجازهٔ این کار را ندارد. در ElevenLabs دسترسی‌های کلید را ویرایش کنید و «Speech to Text» را فعال کنید."
          }
        }
      }
    },
    "This clip has no audio track.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلیپ صدا ندارد."
          }
        }
      }
    },
    "This clip is too large for the service.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلیپ برای سرویس بیش از حد بزرگ است."
          }
        }
      }
    },
    "This folder (including subfolders) has no clips the app can read.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این پوشه (و زیرپوشه‌هایش) کلیپی نیست که برنامه بتواند بخواند."
          }
        }
      }
    },
    "Tick the clips you want (or press “Select All”). Clips that already have subtitles are greyed out.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیپ‌های موردنظر را تیک بزنید (یا «انتخاب همه» را بزنید). کلیپ‌هایی که از قبل زیرنویس دارند خاکستری‌اند."
          }
        }
      }
    },
    "Tips": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نکته‌ها"
          }
        }
      }
    },
    "To redo a clip, delete its .srt in Finder — the list updates by itself. If the clip still has its .transcript.json, subtitles are rebuilt instantly without uploading again. That is also how to apply new subtitle settings to clips you have already done.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ساخت دوبارهٔ زیرنویس یک کلیپ، فایل ‎.srt آن را در Finder پاک کنید — فهرست خودبه‌خود به‌روز می‌شود. اگر فایل ‎.transcript.json کلیپ هنوز هست، زیرنویس فوراً و بدون بارگذاری دوباره ساخته می‌شود. برای اعمال تنظیمات جدید زیرنویس روی کلیپ‌های قبلی هم همین راه را بروید."
          }
        }
      }
    },
    "Transcribe the ticked clips": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخت زیرنویس برای کلیپ‌های تیک‌خورده"
          }
        }
      }
    },
    "Transcribing…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال تبدیل گفتار به متن…"
          }
        }
      }
    },
    "Transcription finished": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخت زیرنویس تمام شد"
          }
        }
      }
    },
    "Transcription service": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس تبدیل گفتار به متن"
          }
        }
      }
    },
    "Turkish": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترکی"
          }
        }
      }
    },
    "Unexpected reply from the service (%lld).": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ غیرمنتظره از سرویس (%lld)."
          }
        }
      }
    },
    "Uploading": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال بارگذاری"
          }
        }
      }
    },
    "Use the globe button to switch the app between English and Persian.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با دکمهٔ کره، زبان برنامه را بین انگلیسی و فارسی عوض کنید."
          }
        }
      }
    },
    "User Guide": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راهنمای کاربر"
          }
        }
      }
    },
    "Waiting…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در انتظار…"
          }
        }
      }
    },
    "When it finishes, every clip has an .srt file (and a .transcript.json) next to it.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی تمام شد، کنار هر کلیپ یک فایل ‎.srt (و یک ‎.transcript.json) هست."
          }
        }
      }
    },
    "Will rebuild from the saved transcript (no upload)": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از متن ذخیره‌شده دوباره ساخته می‌شود (بدون بارگذاری)"
          }
        }
      }
    },
    "Your account has run out of credits.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتبار حساب شما تمام شده است."
          }
        }
      }
    }
  },
  "version": "1.0"
}